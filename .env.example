# Supabase public configuration from the existing TopicTrail Cloud SG project.
# Append to .env.local without replacing the retained Firebase configuration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Historical Firebase rollback configuration (not used by the production session).
# These EXPO_PUBLIC values are public project identifiers, not admin credentials.
# Never put service-account JSON, private keys, passwords or refresh tokens here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
