# Supabase public configuration from the existing TopicTrail Cloud SG project.
# Append to .env.local without replacing the retained Firebase configuration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set only after code-only signup and recovery emails are enabled and verified on this exact project.
EXPO_PUBLIC_TOPICTRAIL_EMAIL_CODES_REF=
# Set only on an isolated staging build, to its own reviewed Supabase project reference.
EXPO_PUBLIC_TOPICTRAIL_QUOTA_STAGING_REF=

# Historical Firebase rollback configuration (not used by the production session).
# These EXPO_PUBLIC values are public project identifiers, not admin credentials.
# Never put service-account JSON, private keys, passwords or refresh tokens here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
